# QA-only image. Python 3.13.13 / Debian bookworm pinned to a registry manifest.
# Review the digest and OS security updates during scheduled QA dependency refresh.
FROM python:3.13.13-slim-bookworm@sha256:355bfa66770995d7e9a0da4b3473b44d0cb451f6b56f5615ad9c39e3c4eca03f
ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1
WORKDIR /opt/coffee
# The Node.js executable is required by the clipboard regression test, not merely
# Playwright's bundled driver. Debian bookworm provides an adequate Node version.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && node --version \
    && rm -rf /var/lib/apt/lists/*
COPY . .
# Constraints are the actual QA inputs, not an informational-only snapshot.
RUN python -m pip install -c requirements-verified.txt setuptools wheel \
    && python -m pip install -c requirements-verified.txt --no-build-isolation -e '.[dev]' \
    && python -m playwright install --with-deps chromium
CMD ["python", "scripts/verify_release.py"]
