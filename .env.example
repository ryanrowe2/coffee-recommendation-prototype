# Local mode is safe and requires no external accounts.
APP_MODE=local
PORT=5050
APP_DB_PATH=.local_data/recommendations.sqlite3
# APP_CATALOG_PATH=/absolute/path/to/custom/synthetic-catalog.json

# Signed mock webhooks are disabled unless you set a private secret.
# TYPEFORM_WEBHOOK_SECRET=replace-with-a-long-random-local-secret
# TYPEFORM_FORM_ID=DEMO_COFFEE_FORM

# Example of a restrictive CORS allowlist, if needed for an authorized test site.
# ALLOWED_ORIGINS=https://example.com
